{
  "name": "dsh-fastlane",
  "version": "0.2.0",
  "description": "Fastlane for the DeepSeek Harness desktop app — zero-call turn classifier (reuse / direct / plan / normal), tail-injected plan directives with a parallel hint, deterministic context pruning, and opt-in pattern reuse. Every layer is switchable and cache-safe.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "patterns.example.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.1-rc.2 || ^0.2.1-rc.3 || ^0.2.1-rc.4 || ^0.2.1-rc.5 || ^0.2.2-alpha.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "context",
    "caching",
    "compaction"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "category": "tools",
    "displayName": "Fastlane",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "^0.2.1-rc.5 || ^0.2.2-alpha.2",
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-alpha.2": "compatible"
      },
      "profiles": [
        "headless",
        "web",
        "desktop"
      ]
    }
  }
}
